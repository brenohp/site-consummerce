generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Modelo de Utilizadores (Acesso ao Dashboard)
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios")
}

// Modelo da Empresa (Cliente B2B)
model Empresa {
  id           String   @id @default(cuid())
  nome         String
  cnpj         String?  @unique
  telefone     String?  // NOVO: Telefone principal da empresa
  endereco     String?  // NOVO: Endereço físico
  site         String?
  status       String   @default("ATIVO") // ATIVO, INATIVO, PROSPECT
  gerenciaSite Boolean  @default(false)   // NOVO: Indica se gere o site/domínio
  anotacoes    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contatos   Contato[]
  servicos   Servico[]
  transacoes TransacaoFinanceira[] 

  @@map("empresas")
}

// Modelo de Contatos (As pessoas físicas ligadas à empresa)
model Contato {
  id               String  @id @default(cuid())
  nome             String
  email            String
  telefone         String? // Telefone direto da pessoa
  cargo            String? // Ex: Gerente de TI, Dono, Financeiro
  statusProspeccao String  @default("NAO_ABORDADO") 
  
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("contatos")
}

// Registo de Serviços/Projetos vendidos
model Servico {
  id          String   @id @default(cuid())
  titulo      String
  descricao   String?
  valor       Float
  status      String   @default("EM_ANDAMENTO")
  dataServico DateTime @default(now()) // NOVO: Data de realização do serviço
  
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("servicos")
}

// Controlo Financeiro
model TransacaoFinanceira {
  id          String   @id @default(cuid())
  descricao   String
  tipo        String   
  valor       Float
  categoria   String?  
  dataPgto    DateTime @default(now())
  
  empresaId   String?  
  empresa     Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("transacoes_financeiras")
}